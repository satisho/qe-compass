# Copy to .env (next to start.bat) to change settings. All are optional.

# Where the database and uploaded evidence are kept (default: ./data)
# QEC_DATA_DIR=./data

# Address and port. 127.0.0.1 = only this computer can open it.
# Set QEC_HOST=0.0.0.0 to let colleagues on the same network connect.
# QEC_HOST=127.0.0.1
# QEC_PORT=8000

# Use PostgreSQL instead of the built-in SQLite file (server deployments):
# QEC_DATABASE_URL=postgresql+psycopg://qecompass:CHANGE_ME@localhost:5432/qecompass

# Sign-in session length, in hours
# QEC_SESSION_HOURS=12

# Set to true when served over HTTPS (behind a reverse proxy or load balancer)
# QEC_COOKIE_SECURE=false

# Largest evidence file accepted, in MB
# QEC_MAX_UPLOAD_MB=25

# Analysis engine. "rules" is the built-in offline engine.
# QEC_AI_PROVIDER=rules

# ---- Security (1.0.1) ----
# Sign out after this many minutes without activity (0 = off)
# QEC_IDLE_MINUTES=60

# Require every user to set up two-step verification (authenticator app)
# QEC_REQUIRE_MFA=false

# Serve HTTPS directly with a certificate and private key (PEM files).
# Not needed when a reverse proxy or load balancer provides HTTPS.
# QEC_TLS_CERT=C:/certs/qe-compass.crt
# QEC_TLS_KEY=C:/certs/qe-compass.key

# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated, or * for any)
# QEC_TRUSTED_PROXIES=127.0.0.1

# Interactive API documentation at /api/docs (development only)
# QEC_API_DOCS=false
